# Copy this file to ".env" in the project root to customize settings.
# None of these are required to run the app — sensible defaults are used
# if left blank, and the free DuckDuckGo-based search works with no key.

# "duckduckgo" (default, no key needed), "bing", or "brave"
#
# DuckDuckGo's HTML results page requires no signup, but it (like any
# free scraped search page) can rate-limit or bot-check a given network
# at any time — that shows up as searches finding zero results even
# with a fine internet connection. If that happens consistently, switch
# to "bing" or "brave" below for a reliable, officially supported path.
SEARCH_PROVIDER=duckduckgo

# Required if SEARCH_PROVIDER=bing or SEARCH_PROVIDER=brave. Never
# exposed to the browser — read only by the backend.
#   bing:  Azure "Bing Search v7" resource key - https://portal.azure.com
#   brave: Brave Search API key (free tier available) - https://api.search.brave.com/app/keys
SEARCH_PROVIDER_API_KEY=

# How long to wait for any single network request before giving up.
REQUEST_TIMEOUT_SECONDS=10

# Cap on how many search-engine results are considered per query.
MAX_RESULTS_PER_SOURCE=20

# How many candidate property pages are fetched at the same time.
MAX_CONCURRENT_FETCHES=5

# How many distinct web-search queries are generated per search.
MAX_QUERIES_PER_SEARCH=12

# How many past search sessions are kept in memory (for GET /api/search/{id}).
MAX_STORED_SESSIONS=100

# Preferred local port. If busy, the app automatically tries the next ones.
PORT=8000
